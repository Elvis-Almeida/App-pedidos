# =============================================================
#  Vendas Online — configuração do SERVIDOR (Docker Swarm + Traefik)
#
#  1. Copie:   cp .env.exemplo .env
#  2. Ajuste os valores abaixo
#  3. Publique: ./deploy.sh
#     (para conferir antes, sem publicar: ./deploy.sh --conferir)
#
#  O `docker stack deploy` NÃO lê este arquivo sozinho. O deploy.sh carrega
#  e repassa. Se quiser rodar na mão:
#     set -a; . ./.env; set +a
#     docker stack deploy -c docker-compose.yml "$VENDAS_STACK"
#
#  Formato: NOME=valor, sem espaços em volta do "=". Aspas só se o valor
#  tiver espaço. Pode salvar no Windows: o deploy.sh limpa o fim de linha.
# =============================================================


# ---------- Endereço ----------

# Nome da stack no Swarm. Vira prefixo de tudo: serviços (vendas_api),
# segredos (vendas_secret_key), volumes (vendas_banco) e roteadores do Traefik.
# Produção: vendas · Homologação: vendas-dev (use o .env.dev)
VENDAS_STACK=vendas

# Domínio do app. Precisa de um registro DNS (A ou CNAME) apontando para a VPS.
# O admin fica em https://<domínio>/admin
VENDAS_DOMINIO=vendas.elvisalmeida.com.br


# ---------- Traefik ----------

# Rede externa do Traefik (a mesma usada pelas outras stacks, ex.: Lumen).
# Para conferir:  docker network ls --filter driver=overlay
VENDAS_REDE_TRAEFIK=crononest

# Nome do certresolver do Let's Encrypt configurado no Traefik
VENDAS_CERTRESOLVER=letsencryptresolver

# Entrypoint HTTPS do Traefik
VENDAS_ENTRYPOINT=websecure


# ---------- Desempenho ----------

# Réplicas da API. 2 = atualização sem tirar o app do ar.
VENDAS_REPLICAS=2

# Processos e threads do gunicorn por réplica. 2×4 atende com folga dezenas
# de celulares sincronizando ao mesmo tempo.
VENDAS_WORKERS=2
VENDAS_THREADS=4


# ---------- Administrador ----------

# Usuário criado automaticamente na primeira subida (se ainda não existir).
VENDAS_ADMIN_USUARIO=elvis
VENDAS_ADMIN_EMAIL=contato@elvisalmeida.com.br


# ---------- Backup ----------

# Quantos dias de backup diário (banco + fotos) ficam guardados no servidor.
VENDAS_BACKUP_DIAS=30


# ---------- Segredos (opcional) ----------
#
# Deixe em branco para o deploy.sh gerar valores aleatórios fortes (o
# recomendado). Preencha só se quiser escolher. Eles são usados UMA VEZ, para
# criar os segredos do Docker (vendas_secret_key, vendas_db_password,
# vendas_admin_senha). Depois disso, mudar aqui não muda nada: para trocar,
# remova o segredo com `docker secret rm` e publique de novo.
#
# Senha do admin: no mínimo 10 caracteres. Se ficar em branco, o deploy.sh
# mostra a senha gerada no terminal, uma vez só.
VENDAS_ADMIN_SENHA=
# Senha do PostgreSQL. Só vale ANTES de o banco existir: depois de criado,
# a senha fica gravada nele.
VENDAS_DB_PASSWORD=
# Chave secreta do Django (assina sessões do admin). Mínimo 50 caracteres.
VENDAS_SECRET_KEY=
