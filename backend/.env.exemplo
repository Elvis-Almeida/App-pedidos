# =============================================================
#  Vendas Online — rodar o Django direto no computador, SEM Docker
#
#  cp .env.exemplo .env      (dentro da pasta backend/)
#  python manage.py preparar
#  python manage.py runserver
#
#  O Django lê este arquivo sozinho ao iniciar. Variáveis já definidas no
#  terminal têm prioridade sobre o que está aqui.
#  (Com Docker — compose.dev.yml — não precisa deste arquivo.)
# =============================================================

# 1 = modo desenvolvimento (mensagens de erro detalhadas, sem cache do app)
VENDAS_DEBUG=1

# Endereços aceitos. "*" libera abrir pelo IP do computador (ex.: no celular).
VENDAS_HOSTS=*

# Em desenvolvimento pode ficar em branco (usa uma chave de teste)
VENDAS_SECRET_KEY=

# ---------- Banco ----------
# Em branco = SQLite (arquivo backend/dev.sqlite3), sem instalar nada.
# Para usar PostgreSQL, preencha o host:
VENDAS_DB_HOST=
VENDAS_DB_PORT=5432
VENDAS_DB_NAME=vendas
VENDAS_DB_USER=vendas
VENDAS_DB_PASSWORD=

# Onde ficam fotos e logo enviados pelo admin (em branco = backend/media)
VENDAS_MEDIA_ROOT=

# ---------- Administrador ----------
# Criado pelo "python manage.py preparar" se ainda não existir
VENDAS_ADMIN_USUARIO=admin
VENDAS_ADMIN_SENHA=admin-dev-123
VENDAS_ADMIN_EMAIL=
