# =============================================================
#  Vendas Online — HOMOLOGAÇÃO no mesmo servidor
#
#  cp .env.dev.exemplo .env.dev   e depois   ./deploy.sh dev
#
#  Mesmas chaves do .env.exemplo (as explicações estão lá). Por ter outro
#  VENDAS_STACK, a homologação tem banco, fotos, segredos e roteadores
#  próprios: mexer aqui nunca toca a produção.
# =============================================================

VENDAS_STACK=vendas-dev
# Crie o DNS deste domínio apontando para a VPS
VENDAS_DOMINIO=vendas-dev.elvisalmeida.com.br

VENDAS_REDE_TRAEFIK=crononest
VENDAS_CERTRESOLVER=letsencryptresolver
VENDAS_ENTRYPOINT=websecure

# Homologação não precisa de duas réplicas
VENDAS_REPLICAS=1
VENDAS_WORKERS=1
VENDAS_THREADS=4

VENDAS_ADMIN_USUARIO=elvis
VENDAS_ADMIN_EMAIL=contato@elvisalmeida.com.br

VENDAS_BACKUP_DIAS=7

# Em branco = gerados automaticamente pelo deploy.sh
VENDAS_ADMIN_SENHA=
VENDAS_DB_PASSWORD=
VENDAS_SECRET_KEY=
